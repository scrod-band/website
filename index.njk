<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SCROD — Funk Forward</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Mono:wght@300;400;500&family=Crimson+Pro:ital,wght@0,300;0,400;1,300;1,400&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="styles.css" />
</head>
<body>

  <!-- ============================================================
       LIGHTBOX (photo viewer overlay — do not edit)
       ============================================================ -->
  <div id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button id="lb-close" aria-label="Close">✕</button>
    <button class="lb-btn" id="lb-prev" aria-label="Previous photo">‹</button>
    <div class="lb-img-wrap">
      <img id="lb-img" src="" alt="" />
      <div class="lb-caption" id="lb-caption"></div>
    </div>
    <button class="lb-btn" id="lb-next" aria-label="Next photo">›</button>
    <div class="lb-counter" id="lb-counter"></div>
    <div class="lb-swipe-hint">swipe to browse</div>
  </div>


  <!-- ============================================================
       NAVIGATION
       ============================================================ -->
  <nav id="navbar">
    <a class="nav-brand" href="#hero">
      <img class="nav-logo-img" src="logo.png" alt="Scrodphunk fish logo" />
      <span class="nav-logo-text">SCROD</span>
    </a>
    <ul class="nav-links">
      <li><a href="#bio">About</a></li>
      <li><a href="#shows">Shows</a></li>
      <li><a href="#videos">Videos</a></li>
      <li><a href="#photos">Photos</a></li>
      <li><a href="#connect">Connect</a></li>
    </ul>
  </nav>


  <!-- ============================================================
       HERO — the big splash section at the top
       Text comes from _data/site.json (editable in the CMS)
       ============================================================ -->
  <section id="hero">
    <div class="fish-bg" aria-hidden="true">
      <svg class="fish" viewBox="0 0 100 50"><path d="M80,25 Q60,5 20,25 Q60,45 80,25 Z M80,25 L100,10 L95,25 L100,40 Z"/></svg>
      <svg class="fish" viewBox="0 0 100 50"><path d="M80,25 Q60,5 20,25 Q60,45 80,25 Z M80,25 L100,10 L95,25 L100,40 Z"/></svg>
      <svg class="fish" viewBox="0 0 100 50"><path d="M80,25 Q60,5 20,25 Q60,45 80,25 Z M80,25 L100,10 L95,25 L100,40 Z"/></svg>
      <svg class="fish" viewBox="0 0 100 50"><path d="M80,25 Q60,5 20,25 Q60,45 80,25 Z M80,25 L100,10 L95,25 L100,40 Z"/></svg>
    </div>

    <div class="hero-inner">
      <p class="hero-eyebrow">{{ site.eyebrow }}</p>

      <h1>SCROD <img src="logo.png" alt="Scrodphunk fish logo" /></h1>

      <p class="hero-tagline">{{ site.tagline }}</p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="#shows">↓ Upcoming Shows</a>
        <a class="btn btn-outline" href="#videos">Watch &amp; Listen</a>
      </div>
    </div>
  </section>


  <!-- ============================================================
       BIO — band description and member list
       Content comes from _data/bio.json (editable in the CMS)
       ============================================================ -->
  <section id="bio">
    <div class="container">
      <div class="bio-grid reveal">

        <div class="bio-text">
          <p class="section-label">Who We Are</p>
          <h2><em>Funk</em> forward,<br>deep end first.</h2>
          <p>{{ bio.text }}</p>
        </div>

        <div class="members-card reveal reveal-delay-2">
          <h3>The Band</h3>
          {% for member in bio.members %}
          <div class="member">
            <div class="member-dot"></div>
            <span class="member-name">{{ member.name }}</span>
            <span class="member-role">{{ member.role }}</span>
          </div>
          {% endfor %}
        </div>

      </div>
    </div>
  </section>


  <!-- ============================================================
       SHOWS — upcoming gigs
       Content comes from _data/shows.json (editable in the CMS).
       Past shows are hidden automatically at build time.
       ============================================================ -->
  <section id="shows">
    <div class="container">
      <div class="shows-header reveal">
        <div>
          <p class="section-label">Live</p>
          <h2>Upcoming <em>Shows</em></h2>
        </div>
      </div>

      <div class="shows-list reveal reveal-delay-1">
        {% set upcomingShows = shows.shows | upcoming %}
        {% for show in upcomingShows %}
        {% if show.ticketUrl %}
        <a class="show-item" href="{{ show.ticketUrl }}" target="_blank">
          <div class="show-date">{% if show.date %}{{ show.date | showMonthDay }}<br>{{ show.date | showYear }}{% endif %}{% if show.time %}<br>{{ show.time }}{% endif %}</div>
          <div class="show-info">
            <div class="show-venue">{{ show.venue }}</div>
            <div class="show-location">{{ show.location }}</div>
          </div>
          <div class="show-ticket">Tickets →</div>
        </a>
        {% else %}
        <div class="show-item">
          <div class="show-date">{% if show.date %}{{ show.date | showMonthDay }}<br>{{ show.date | showYear }}{% endif %}{% if show.time %}<br>{{ show.time }}{% endif %}</div>
          <div class="show-info">
            <div class="show-venue">{{ show.venue }}</div>
            <div class="show-location">{{ show.location }}</div>
          </div>
        </div>
        {% endif %}
        {% else %}
        <div class="shows-empty">
          No shows on the books right now — check back soon.
        </div>
        {% endfor %}
      </div>
    </div>
  </section>


  <!-- ============================================================
       VIDEOS — YouTube embeds and links
       Content comes from _data/videos.json (editable in the CMS).
       type "embed" + a YouTube video ID → embedded player card
       type "link" + a URL → clickable row, no embed
       ============================================================ -->
  <section id="videos">
    <div class="container">
      <div class="reveal">
        <p class="section-label">Watch</p>
        <h2>Videos &amp; <em>Live Clips</em></h2>
      </div>

      <div class="video-grid">

        {% for video in videos.videos %}
        {% if video.type == "embed" %}
        <div class="video-card reveal">
          <div class="video-embed">
            <iframe
              src="https://www.youtube.com/embed/{{ video.youtubeId }}"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen loading="lazy">
            </iframe>
          </div>
          <div class="video-meta">
            <div class="video-title">{{ video.title }}</div>
            <div class="video-subtitle">{{ video.subtitle }}</div>
          </div>
        </div>
        {% else %}
        <a class="video-link-card reveal" href="{{ video.url }}" target="_blank">
          <div class="yt-icon"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
          <div>
            <div class="video-title">{{ video.title }}</div>
            <div class="video-subtitle">{{ video.subtitle }}</div>
          </div>
        </a>
        {% endif %}
        {% endfor %}

        <!-- Link to full YouTube channel -->
        <a class="video-link-card reveal reveal-delay-1" href="https://youtube.com/@scrodphunk" target="_blank">
          <div class="yt-icon"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
          <div>
            <div class="video-title">See All Videos</div>
            <div class="video-subtitle">youtube.com/@scrodphunk</div>
          </div>
        </a>

      </div>
    </div>
  </section>


  <!-- ============================================================
       PHOTOS — masonry gallery with lightbox
       Content comes from _data/photos.json (editable in the CMS).
       Upload images through the CMS and they land in /photos/.
       ============================================================ -->
  <section id="photos">
    <div class="container">
      <div class="reveal">
        <p class="section-label">Gallery</p>
        <h2><em>Photos</em></h2>
      </div>

      <div class="photo-grid reveal reveal-delay-1" id="photo-grid">
        {% for photo in photos.photos %}
        <div class="photo-item" data-src="{{ photo.image }}"{% if photo.caption %} data-caption="{{ photo.caption }}"{% endif %}>
          <img src="{{ photo.image }}" alt="{{ photo.alt }}" loading="lazy" />
        </div>
        {% endfor %}
      </div>
    </div>
  </section>


  <!-- ============================================================
       CONNECT — social links and merch
       Edit: href links and display names
       ============================================================ -->
  <section id="connect">
    <div class="container">
      <div class="reveal">
        <p class="section-label">Find Us</p>
        <h2>Stay <em>Connected</em></h2>
      </div>

      <div class="connect-grid">

        <!-- ↓ UPDATE HREF LINKS AND DISPLAY NAMES HERE ↓ -->

        <a class="connect-card reveal reveal-delay-1" href="https://instagram.com/scrodphunk" target="_blank">
          <div class="connect-icon instagram">📸</div>
          <div class="connect-label">Instagram</div>
          <div class="connect-name">@scrodphunk</div>
        </a>

        <a class="connect-card reveal reveal-delay-2" href="https://youtube.com/@scrodphunk" target="_blank">
          <div class="connect-icon youtube">▶</div>
          <div class="connect-label">YouTube</div>
          <div class="connect-name">@scrodphunk</div>
        </a>

        <a class="connect-card reveal reveal-delay-3" href="https://www.teepublic.com/user/phomo" target="_blank">
          <div class="connect-icon merch">🎽</div>
          <div class="connect-label">Merch Store</div>
          <div class="connect-name">TeePublic</div>
        </a>
        <a class="connect-card reveal reveal-delay-1" href="https://scrodphunk.bandcamp.com/" target="_blank">
          <div class="connect-icon bandcamp"><img src="bandcamp-button-bc-circle-green-64.png" width="64" height="64"></div>
          <div class="connect-label">bandcamp</div>
          <div class="connect-name">scrod phunk</div>
        </a>

        <!-- ↑ UPDATE HREF LINKS AND DISPLAY NAMES HERE ↑ -->

      </div>
    </div>
  </section>
 <!-- ============================================================
       MAILING LIST — Mailchimp signup
       The form action URL is tied to the Mailchimp account.
       Do not edit the action= URL or the hidden input fields.
       ============================================================ -->
  <section id="mailing-list">
    <div class="container">
      <div class="reveal" style="max-width: 560px; margin: 0 auto; text-align: center;">
        <p class="section-label">Stay in the Loop</p>
        <h2>Join the <em>List</em></h2>
        <p class="mailing-subtext">Show announcements, new music, and whatever else we feel like sending.</p>

        <form
          action="https://scrodphunk.us22.list-manage.com/subscribe/post?u=2e0d8e2a2f2323641a61450ec&amp;id=8065af386b&amp;f_id=00e9c3e1f0"
          method="post"
          id="mc-embedded-subscribe-form"
          name="mc-embedded-subscribe-form"
          target="_blank"
          class="mc-form">

          <div class="mc-field-row">
            <input
              type="email"
              name="EMAIL"
              id="mce-EMAIL"
              placeholder="your@email.com"
              required
              class="mc-email-input" />
            <button type="submit" name="subscribe" class="btn btn-primary mc-submit">
              Subscribe
            </button>
          </div>

          <!-- Mailchimp bot protection — do not remove -->
          <div aria-hidden="true" style="position: absolute; left: -5000px;">
            <input type="text" name="b_2e0d8e2a2f2323641a61450ec_8065af386b" tabindex="-1" value="">
          </div>

          <p class="mc-fine-print">No spam. Unsubscribe anytime.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- ============================================================
       FOOTER
       ============================================================ -->
  <div style="border-top: 1px solid rgba(123,63,160,0.15);">
    <footer>
      <span class="footer-logo">SCROD</span>
      <span class="footer-copy">© {{ currentYear }} Scrod · All rights reserved</span>
    </footer>
  </div>


  <script src="main.js"></script>
</body>
</html>
